# SmartSales - Environment Configuration Template

# Server Port
PORT=3000

# Cryptographic Token Signing Key (Generate via: openssl rand -base64 32)
SECRET_KEY="generate-a-secure-random-secret-key-for-jwt-signing"

# Central Database (Optional: Provide MongoDB connection string to persist to MongoDB Atlas)
# Default fallback: Persistent local file-backed store at .data/smartsales_db.json
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/smartsales?retryWrites=true&w=majority"
MONGODB_DATABASE="smartsales"

# Allowed Cross-Origin Origins
CORS_ORIGINS="*"

# Machine Learning Artifacts Directory
MODEL_DIR="./models"

# AI Studio runtime keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
